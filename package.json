{
  "name": "tpscalls-frontend",
  "version": "3.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite",
    "build:clean": "rm -rf dist",
    "build": "yarn build:clean && vite build",
    "build:dev": "yarn build:clean && NODE_ENV=development vite build",
    "test": "vitest",
    "netlify-deploy": "yarn build && netlify deploy --dir dist",
    "netlify-deploy:prod": "netlify deploy --prod --dir dist",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@daypicker/react": "^10.0.1",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@rdrnt/tps-calls-shared": "^0.2.1",
    "@reduxjs/toolkit": "^2.12.0",
    "@sentry/react": "^10.71.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "firebase": "^12.18.0",
    "fuse.js": "^7.5.0",
    "geolib": "^3.3.14",
    "lucide-react": "^0.577.0",
    "mapbox-gl": "^3.29.0",
    "motion": "^12.43.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-ga4": "^3.0.1",
    "react-hook-form": "^7.85.0",
    "react-icons": "^5.7.0",
    "react-map-gl": "^8.1.2",
    "react-redux": "^9.3.0",
    "react-router": "^7.18.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "use-debounce": "^10.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@sentry/vite-plugin": "^5.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/ui": "4.1.11",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
