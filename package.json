{
  "name": "tpscalls-frontend",
  "version": "3.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite",
    "build:clean": "rm -rf dist",
    "build": "yarn build:clean && vite build",
    "build:release": "yarn build:clean && SENTRY_UPLOAD_SOURCEMAPS=true vite build",
    "build:dev": "yarn build:clean && NODE_ENV=development vite build",
    "test": "vitest",
    "netlify-deploy": "yarn build && netlify deploy --dir dist",
    "netlify-deploy:prod": "yarn build:release && netlify deploy --prod --dir dist",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@daypicker/react": "^10.0.1",
    "@hookform/resolvers": "^7.0.8",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@rdrnt/tps-calls-shared": "^1.1.0",
    "@reduxjs/toolkit": "^2.15.0",
    "@sentry/react": "^11.16.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "firebase": "^13.4.0",
    "fuse.js": "^7.5.0",
    "lucide-react": "^1.77.0",
    "mapbox-gl": "^3.35.2",
    "motion": "^14.14.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-ga4": "^3.0.1",
    "react-hook-form": "^7.92.0",
    "react-icons": "^5.7.0",
    "react-map-gl": "^8.1.2",
    "react-redux": "^9.3.0",
    "react-router": "^8.5.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "use-debounce": "^10.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@sentry/vite-plugin": "^11.16.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.13",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/ui": "5.1.1",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "5.1.1"
  }
}
